# opensea-scraper — copy to `.env` and fill in what you need.
#
#   cp .env.example .env
#   python3 env_config.py          # prints what was picked up, without
#                                  # printing any secret
#
# NOTHING HERE IS REQUIRED to scrape OpenSea. Measured from one Hetzner
# datacentre address in Helsinki on 2026-09-17: every page kind, every mode
# and every locale answered HTTP 200 with no key, no proxy and no account,
# and the site's own GraphQL endpoint answered an anonymous POST. What these
# buy is volume from many addresses, a specific country, browser
# infrastructure you do not run, and a solver for the day Cloudflare does
# issue its managed challenge. The README says so in those words.
#
# PRECEDENCE, highest first: an explicit flag on the command line, then an
# exported environment variable, then this file, then the default. A `.env`
# never overrides something you typed, and never clobbers a CI secret.
#
# `.gitignore` keeps `.env` out of the repository and `.dockerignore` keeps
# it out of an image — a credential baked into an image is a credential
# published to everyone who can pull it.

# Your 2captcha.com API key. One key, four separately billed products:
# captcha solving, the Scraping Browser API, proxies and fingerprints.
TWOCAPTCHA_KEY=your_2captcha_api_key_here

# The Scraping Browser API endpoint, for --cdp-endpoint. THE SHAPE, not a
# working one: a profile's credentials live about a day, so a pasted endpoint
# is stale by tomorrow and produces an auth error a long way from its cause.
# Get a fresh one from the 2Captcha dashboard.
#
#   country-xx  picks the exit country
#   pid-…       is a profile with persistent cookies, ONE live connection
#               each — reuse pids rather than minting one per run
#
# Note `{login}` and `{password}` below: `env_config.py` treats any value
# still carrying a `{…}` placeholder as UNSET, so a copied example is never
# sent to the API as if it were configured.
OPENSEA_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-us-pid-{profileId}:{password}@cb.2captcha.com:9222

# A proxy for --proxy. Same placeholder rule.
OPENSEA_PROXY=http://{user}:{password}@us.proxy.2captcha.com:2334

# A default --url, so a bare `python3 playwright_scraper.py` has somewhere to
# go. Deliberately NOT mapped onto --out or --sort: env_config only fills
# values that are unset, so mapping a variable onto a flag with a non-empty
# default would make it silently inert — a setting that looks configurable
# and is not.
OPENSEA_URL=https://opensea.io/collection/boredapeyachtclub
